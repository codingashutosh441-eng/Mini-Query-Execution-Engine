# ==========================================
.env
.env.local
.env.dev
.env.production
*.pem
*.key
*.passwd

# ==========================================
# 2. SYSTEM FILES (OS SPECIFIC)
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# ==========================================
